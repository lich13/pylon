{
  "b5d6e708bf6e": {
    "name": "Gmail 自动清理",
    "profile": "default",
    "schedule": "0 1 * * *",
    "deliver": true,
    "timeout": 900,
    "module": "pylon.tasks.gmail.cleanup",
    "args": [
      "--format",
      "text",
      "--quiet-noop"
    ]
  },
  "xianbao-poll": {
    "name": "线报筛选",
    "profile": "default",
    "schedule": "* * * * *",
    "deliver": false,
    "timeout": 900,
    "failure_notify": false,
    "module": "pylon.tasks.xianbao.poll"
  },
  "xianbao-retention-cleanup": {
    "name": "线报数据清理",
    "profile": "default",
    "schedule": "15 4 * * *",
    "deliver": false,
    "timeout": 900,
    "args": [
      "--apply",
      "--json"
    ],
    "module": "pylon.tasks.cleanup.xianbao"
  },
  "93e1c037c069": {
    "name": "V2EX 监控",
    "profile": "webops",
    "schedule": "* * * * *",
    "deliver": true,
    "timeout": 1800,
    "module": "pylon.tasks.forums.v2ex"
  },
  "7096dc039b73": {
    "name": "日港 iTunes 报告",
    "profile": "webops",
    "schedule": "30 * * * *",
    "deliver": true,
    "timeout": 1800,
    "module": "pylon.tasks.itunes.report"
  },
  "e72aa411d7f9": {
    "name": "业务数据清理",
    "profile": "webops",
    "schedule": "20 4 * * *",
    "deliver": false,
    "timeout": 1800,
    "module": "pylon.tasks.cleanup.profile"
  },
  "63c6ab6c4af3": {
    "name": "Chiphell 新帖投递",
    "profile": "webops",
    "schedule": "* * * * *",
    "deliver": true,
    "timeout": 1800,
    "module": "pylon.tasks.chiphell.dispatch"
  },
  "f3ec3ec24210": {
    "name": "KDocs 报价刷新",
    "profile": "webops",
    "schedule": "55 9,12,15,18 * * *",
    "deliver": true,
    "timeout": 1800,
    "lock": "kdocs-quotes",
    "failure_notify": false,
    "module": "pylon.tasks.quotes.monitor",
    "args": [
      "--mode",
      "main"
    ]
  },
  "e961da51fe69": {
    "name": "KDocs 失败重试",
    "profile": "webops",
    "schedule": "*/15 * * * *",
    "deliver": true,
    "timeout": 1800,
    "lock": "kdocs-quotes",
    "failure_notify": false,
    "module": "pylon.tasks.quotes.monitor",
    "args": [
      "--mode",
      "retry"
    ]
  },
  "fa27c561ded6": {
    "name": "软件更新监控",
    "profile": "webops",
    "schedule": "* * * * *",
    "deliver": false,
    "timeout": 1800,
    "lock": "software-update-monitor",
    "module": "pylon.tasks.software.monitor",
    "args": [
      "--enqueue-only"
    ]
  },
  "software-update-enrich": {
    "name": "软件更新翻译提炼",
    "profile": "webops",
    "schedule": "* * * * *",
    "deliver": false,
    "timeout": 720,
    "lock": "software-update-monitor",
    "failure_notify": true,
    "module": "pylon.tasks.software.enrich"
  },
  "b7a84d1d9f21": {
    "name": "Linux.do 监控",
    "profile": "webops",
    "schedule": "* * * * *",
    "deliver": true,
    "timeout": 1800,
    "module": "pylon.tasks.forums.linuxdo"
  },
  "de91ae783a36": {
    "name": "通知补发核对",
    "profile": "webops",
    "schedule": "*/5 * * * *",
    "deliver": false,
    "timeout": 1800,
    "failure_notify": false,
    "module": "pylon.tasks.software.replay"
  },
  "ssh-admin-sync": {
    "name": "SSH 可信登录 IP 同步",
    "profile": "webops",
    "admin_action": "sync",
    "schedule": "*/5 * * * *",
    "monotonic": true,
    "lock": "ssh-maintenance",
    "deliver": false,
    "timeout": 180
  },
  "ssh-beijing-refresh": {
    "name": "SSH 北京 IP 段更新",
    "profile": "webops",
    "admin_action": "refresh",
    "schedule": "20 4 3 * *",
    "jitter": true,
    "lock": "ssh-maintenance",
    "deliver": false,
    "timeout": 900
  },
  "software-maintenance": {
    "name": "每周软件维护汇总",
    "profile": "webops",
    "schedule": "0 9 * * 1",
    "deliver": false,
    "timeout": 300,
    "module": "pylon.tasks.software.maintenance"
  },
  "software-update-review": {
    "name": "系统小包更新确认",
    "profile": "default",
    "schedule": "15 */6 * * *",
    "deliver": false,
    "timeout": 300,
    "failure_notify": true,
    "module": "pylon.tasks.software.review"
  }
}
