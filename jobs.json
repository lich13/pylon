{
  "ssh-admin-sync": {
    "name": "SSH 可信登录 IP 同步",
    "profile": "webops",
    "admin_action": "sync",
    "schedule": "*/5 * * * *",
    "monotonic": true,
    "lock": "ssh-maintenance",
    "deliver": false,
    "timeout": 180
  },
  "ssh-beijing-refresh": {
    "name": "SSH 北京 IP 段更新",
    "profile": "webops",
    "admin_action": "refresh",
    "schedule": "20 4 3 * *",
    "jitter": true,
    "lock": "ssh-maintenance",
    "deliver": false,
    "timeout": 900
  }
}
