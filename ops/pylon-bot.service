[Unit]
Description=pylon Telegram bot and durable notifications
After=network-online.target
Wants=network-online.target

[Service]
User=pylon
Group=pylon
UMask=0077
WorkingDirectory=/srv/pylon
Environment=HOME=/srv/pylon/home
Environment=PYLON_HOME=/srv/pylon
Environment=TZ=Asia/Shanghai
ExecStart=/srv/pylon/venv/bin/pylon daemon
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
