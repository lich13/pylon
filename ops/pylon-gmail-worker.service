[Unit]
Description=pylon durable Gmail workspace actions
After=network.target

[Service]
User=pylon
Group=pylon
WorkingDirectory=/srv/pylon
Environment=PYLON_HOME=/srv/pylon
Environment=TZ=Asia/Shanghai
ExecStart=/srv/pylon/venv/bin/python -m pylon.cli modules serve gmail worker --profile default
Restart=on-failure
RestartSec=5
UMask=0077
# The worker uses only the existing allowlisted pylon-admin Agent protocol.
# A stop drains the current action; model work continues in pylon-agent.
TimeoutStopSec=infinity
KillMode=process
PrivateTmp=true

[Install]
WantedBy=multi-user.target
