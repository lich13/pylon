[Unit]
Description=pylon on-demand agent turn and session cleanup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/root
ExecStart=/srv/pylon/venv/bin/python -I -m pylon.admin.agents worker
TimeoutStartSec=90000
TimeoutStopSec=20
KillMode=control-group
PrivateTmp=true
StandardOutput=null
StandardError=journal
