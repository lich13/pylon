[Unit]
Description=pylon owner trading filters
After=network.target

[Service]
User=pylon
Group=pylon
WorkingDirectory=/srv/pylon
Environment=PYLON_HOME=/srv/pylon
Environment=TZ=Asia/Shanghai
ExecStart=/srv/pylon/venv/bin/uvicorn pylon.tasks.marketplace.web:create_app --factory --host 127.0.0.1 --port 8794 --workers 1 --no-access-log --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/pylon/data
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
