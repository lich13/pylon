[Unit]
Description=pylon SSH Beijing IPv4 set
DefaultDependencies=no
Before=ufw.service network-pre.target
Wants=network-pre.target
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/srv/pylon/venv/bin/python -I -m pylon.admin.ssh load
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
